{
    "name": "lumineoss/paystart-gateway-xendit",
    "description": "Xendit adapter wrapping xendit/xendit-php with an injected Guzzle client.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "lumineoss/paystart-core": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "xendit/xendit-php": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Lumineoss\\Paystart\\Gateway\\Xendit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lumineoss\\Paystart\\Gateway\\Xendit\\Tests\\": "tests/"
        }
    }
}
